{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/plugin.schema.json",
  "name": "web-compat-mcp",
  "version": "0.3.0",
  "description": "ブラウザ互換性 MCP server。MDN BCD と W3C WebDX web-features (Baseline) に基づき、機能サポート状況の確認・比較・検索を提供。",
  "author": {
    "name": "shuji-bonji",
    "email": "bonji@mikuro.jp",
    "url": "https://github.com/shuji-bonji"
  },
  "homepage": "https://github.com/shuji-bonji/web-compat-mcp",
  "repository": "https://github.com/shuji-bonji/web-compat-mcp",
  "license": "MIT",
  "keywords": [
    "browser-compatibility",
    "baseline",
    "mdn",
    "bcd",
    "web-features",
    "mcp",
    "mcp-server"
  ],
  "mcpServers": {
    "web-compat": {
      "command": "npx",
      "args": [
        "-y",
        "@shuji-bonji/web-compat-mcp@latest"
      ]
    }
  }
}
